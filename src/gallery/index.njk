---
layout: layouts/base.njk
title: Gallery
description: "Deep sky astrophotography — nebulae, galaxies, planetary, and solar images by Dustin K."
permalink: /gallery/
galleryPage: true
---

<!--
	GALLERY INDEX PAGE
	Displays all PUBLISHED images with category filtering.

	`publishedImages` is `images.json` minus any entries marked
	`"published": false`. The filtering happens in src/_data/publishedImages.js.
	We use it (not the raw `images` global) so unpublished placeholder entries
	(e.g. solar-ha-prominence while the rig isn't set up yet) don't appear in
	the gallery, count toward the total, or generate a detail page.
-->

<!-- Page header -->
<div class="page-banner container">
	<h1>Gallery</h1>
	<p class="page-subtitle">{{ publishedImages | length }} images — Nebulae · Galaxies · Clusters · Solar</p>
</div>

<div class="container" style="padding-bottom: 80px;">

	<!--
		Filter pills — each data-filter value matches a slug from the image's
		data-tags attribute (a space-separated list of subject tags + catalog slugs).
		A card is shown if its data-tags list includes the selected filter.
		"all" always shows everything.

		Two visual groups:
		  1. Subject type (galaxy, emission-nebula, etc.)
		  2. Catalog collections (messier, caldwell) — indigo accent, visually distinct
	-->
	{#
		Three independent filter dimensions, combined with AND logic:
		  1. Object Type — subject tags (galaxy, emission-nebula, etc.)
		  2. Collections — catalog membership (messier, caldwell)
		  3. Equipment — imaging setup (personal, itelescope, solar)

		Each dimension has its own data attribute on the buttons:
		  data-filter-type, data-filter-cat, data-filter-eq

		A card is visible when it matches ALL active filters. "all" (or no
		selection) in a dimension means no constraint. Clicking an active
		button deselects it (returns that dimension to "all").

		Example: Galaxy + Messier + My Rig = Andromeda only.
	#}
	<div class="gallery-filters" role="group" aria-label="Filter images">

		<div class="filter-group" role="group" aria-label="Filter by object type">
			<span class="filter-group-label">Object Type</span>
			<button class="filter-btn active" data-filter-type="all"              aria-pressed="true">All</button>
			<button class="filter-btn" data-filter-type="galaxy"                  aria-pressed="false">Galaxy</button>
			<button class="filter-btn" data-filter-type="emission-nebula"         aria-pressed="false">Emission Nebula</button>
			<button class="filter-btn" data-filter-type="supernova-remnant"       aria-pressed="false">Supernova</button>
			<button class="filter-btn" data-filter-type="dark-nebula"             aria-pressed="false">Dark Nebula</button>
			<button class="filter-btn" data-filter-type="reflection-nebula"       aria-pressed="false">Reflection Nebula</button>
			<button class="filter-btn" data-filter-type="open-cluster"            aria-pressed="false">Open Cluster</button>
			<button class="filter-btn" data-filter-type="solar"                   aria-pressed="false">Solar</button>
		</div>

		<div class="filter-group filter-group--catalogs" role="group" aria-label="Filter by catalog collection">
			<span class="filter-group-label">Collections</span>
			<button class="filter-btn filter-btn--catalog" data-filter-cat="messier"  aria-pressed="false">Messier</button>
			<button class="filter-btn filter-btn--catalog" data-filter-cat="caldwell" aria-pressed="false">Caldwell</button>
		</div>

		{#
			Equipment filter — matches categories from equipment_category in images.json:
			"personal" = Dustin's own gear, "itelescope" = remote observatories,
			"solar" = Coronado Solarmax (distinct imaging mode).
		#}
		<div class="filter-group filter-group--equipment" role="group" aria-label="Filter by equipment">
			<span class="filter-group-label">Equipment</span>
			<button class="filter-btn filter-btn--equipment" data-filter-eq="personal"   aria-pressed="false">My Rig</button>
			<button class="filter-btn filter-btn--equipment" data-filter-eq="itelescope"  aria-pressed="false">iTelescope</button>
			<button class="filter-btn filter-btn--equipment" data-filter-eq="solar"       aria-pressed="false">Solar</button>
		</div>

	</div>

	<!--
		No-JS notice for the filter pills. gallery.js wires the pill click
		handlers, so without JavaScript the pills above do nothing. Tell no-JS
		visitors filtering is unavailable but reassure them nothing is hidden —
		every published image is already rendered in the grid below. Mirrors the
		comparison-slider's <noscript> precedent on the detail page.
	-->
	<noscript>
		<p class="filter-count">Filtering requires JavaScript. All {{ publishedImages | length }} images are shown below.</p>
	</noscript>

	<!--
		Filter result count — updated by gallery.js whenever the active filter changes.
		aria-live="polite" means screen readers will announce the updated count
		without interrupting the user. The initial text is set server-side so it
		renders correctly even before JS runs.
	-->
	<p class="filter-count" aria-live="polite">Showing all {{ publishedImages | length }} images</p>

	<!-- Gallery grid — all images -->
	<div class="gallery-grid">

		<!--
			Static empty-state paragraph. Must be in the HTML at page load so
			screen readers register the aria-live region before any content
			changes — dynamically injected aria-live elements are ignored by
			NVDA and JAWS. gallery.js queries this element by class and
			shows/hides it rather than creating it.
		-->
		<p class="gallery-empty hidden" aria-live="polite" role="status">No images in this category yet.</p>

		<!--
			Each entry in `publishedImages` is a target (astronomical object).
			`pv` is the primary variant — the one whose thumbnail and metadata
			appear on the gallery tile. For single-variant targets this is the
			only variant. For multi-variant targets it's the one marked `primary: true`.

			Sorting: sortByDate is a custom Eleventy filter (defined in .eleventy.js)
			that reaches into each image's primary variant to compare dates.
			Newest images appear first.
		-->
		{% for image in publishedImages | sortByDate %}
		{#
			Resolve the primary variant for this target.
			primaryVariant is a custom Eleventy filter that returns the variant
			marked primary: true, or the first variant as a fallback.
		#}
		{% set pv = image.variants | primaryVariant %}

		{#
			Card markup lives in partials/gallery-card.njk, shared with the home
			page's "Latest Captures" grid. The include inherits image, pv, and
			loop from this scope (Nunjucks includes share the caller's context).
		#}
		{% include "partials/gallery-card.njk" %}
		{% endfor %}

	</div>
</div>
