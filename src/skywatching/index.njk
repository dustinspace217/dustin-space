---
layout: layouts/base.njk
title: Skywatching
description: "Wide-field night sky photography by Dustin K. — auroras, sunsets, and skylines."
permalink: /skywatching/
---

<!--
	SKYWATCHING PAGE
	A parallel collection to /gallery/ for wide-field atmospheric photography
	that doesn't belong in the deep-sky gallery: auroras, sunsets, skylines.
	Separate page (not a filter on /gallery/) because the metadata model is
	different — no catalog IDs, no DZI tiles, no plate solutions, no exposure
	breakdowns per filter. See src/_data/skywatchingImages.schema.md for full
	schema docs.

	`skywatching` comes from src/_data/skywatching.js, which loads
	skywatchingImages.json and groups entries by category. Each category is
	pre-sorted newest-first.
-->

<!-- Page header -->
<div class="page-banner container">
	<h1>Skywatching</h1>
	<p class="page-subtitle">Aurora · Sunsets · Skylines</p>
</div>

<div class="container" style="padding-bottom: 80px;">

	{#
		Section metadata. Adding a new section means: (1) adding the category
		key here, (2) adding the same key to skywatching.js's CATEGORIES array,
		and (3) tagging entries in skywatchingImages.json with the new category.
		Keeping the section labels and descriptions in one place makes it easy
		to iterate copy without hunting through template markup.
	#}
	{% set sections = [
		{ key: "aurora",  label: "Aurora Borealis", desc: "Solar particles striking Earth's magnetic field, light from the upper atmosphere." },
		{ key: "sunset",  label: "Sunsets",         desc: "Day's last light above the horizon." },
		{ key: "skyline", label: "Skylines",        desc: "Night scenes where Earth and sky meet." }
	] %}

	{% for section in sections %}
		{% set images = skywatching[section.key] %}
		<section class="sky-section" id="sky-{{ section.key }}">
			<div class="sky-section-header">
				<h2>{{ section.label }}</h2>
				<p class="sky-section-desc text-secondary">{{ section.desc }}</p>
			</div>

			{% if images and images.length > 0 %}
				<div class="sky-grid">
					{% for img in images %}
						{#
							Each card is a <button> rather than an <a> because
							skywatching images don't have per-image permalinks
							(unlike gallery detail pages). The lightbox at the
							bottom of the page handles the full-size view.
							Button is the right semantic for "open dialog."
						#}
						<button
							class="sky-card"
							type="button"
							data-preview="{{ img.preview }}"
							data-title="{{ img.title }}"
							data-description="{{ img.description }}"
							data-location="{{ img.location }}"
							data-date="{{ img.date | readableDate }}"
							aria-label="View {{ img.title }} full size"
						>
							<div class="card-thumb">
								<img
									src="{{ img.thumbnail }}"
									alt="{{ img.title }}"
									loading="lazy"
								/>
							</div>
							<div class="card-body">
								<div class="card-title">{{ img.title }}</div>
								<div class="card-meta">
									<span>{{ img.location }}</span>
									<span>{{ img.date | readableDate }}</span>
								</div>
							</div>
						</button>
					{% endfor %}
				</div>
			{% else %}
				<p class="sky-section-empty text-secondary"><em>More coming soon.</em></p>
			{% endif %}
		</section>
	{% endfor %}

</div>

<!--
	LIGHTBOX
	Simple full-screen image overlay — no deep zoom, no panning. Skywatching
	content is wide-field; a regular larger view is sufficient. Hidden by
	default; JS toggles `hidden` attribute on card click.

	Prev/next buttons navigate within the CURRENT category — clicking from
	an Aurora image moves between Aurora images, not into Sunsets. Matches
	how the gallery's per-target detail pages navigate within a target.
	Buttons are disabled (not hidden) at boundaries so the user can see
	"this is the end of the set" without elements jumping around.
-->
<div class="sky-lightbox" id="sky-lightbox" hidden role="dialog" aria-modal="true" aria-labelledby="sky-lightbox-title">
	<button class="sky-lightbox-close" id="sky-lightbox-close" type="button" aria-label="Close image viewer">✕</button>
	<button class="sky-lightbox-nav sky-lightbox-nav--prev" id="sky-lightbox-prev" type="button" aria-label="Previous image in category">‹</button>
	<button class="sky-lightbox-nav sky-lightbox-nav--next" id="sky-lightbox-next" type="button" aria-label="Next image in category">›</button>
	<div class="sky-lightbox-frame">
		<img class="sky-lightbox-img" id="sky-lightbox-img" alt="" />
		<div class="sky-lightbox-caption">
			<h3 class="sky-lightbox-title" id="sky-lightbox-title"></h3>
			<p class="sky-lightbox-meta">
				<span id="sky-lightbox-location"></span>
				<span class="sky-lightbox-dot" aria-hidden="true">·</span>
				<span id="sky-lightbox-date"></span>
			</p>
			<p class="sky-lightbox-desc" id="sky-lightbox-desc"></p>
		</div>
	</div>
</div>

<script>
(function () {
	// Lightbox wiring — minimal vanilla JS, no dependencies.
	// Each .sky-card carries its preview URL and metadata in data-* attrs;
	// clicking it populates the lightbox elements and reveals the overlay.
	var lightbox = document.getElementById('sky-lightbox');
	if (!lightbox) return;

	var img       = document.getElementById('sky-lightbox-img');
	var titleEl   = document.getElementById('sky-lightbox-title');
	var descEl    = document.getElementById('sky-lightbox-desc');
	var locEl     = document.getElementById('sky-lightbox-location');
	var dateEl    = document.getElementById('sky-lightbox-date');
	var closeBtn  = document.getElementById('sky-lightbox-close');
	var prevBtn   = document.getElementById('sky-lightbox-prev');
	var nextBtn   = document.getElementById('sky-lightbox-next');

	// Track the element that opened the lightbox so we can return focus
	// to it on close — a11y best practice for modal dialogs.
	var lastFocused = null;

	// Prev/next navigation context. When the lightbox opens for a card, we
	// snapshot all sibling cards within the same category (same .sky-grid)
	// so the prev/next buttons can move through that set without crossing
	// into other categories. Recomputed on every open() so DOM changes
	// (future filtering, etc.) don't make these references stale.
	var currentSiblings = [];
	var currentIndex    = -1;

	// ── Background inert toggle ──────────────────────────────────────────────
	// While the lightbox is open, everything BEHIND it must be neither
	// focusable nor exposed to the accessibility tree, so Tab and screen-reader
	// virtual cursors can't wander into the page underneath the modal. The
	// `inert` attribute does both at once. We walk from the lightbox up to
	// <body> and, at each level, inert every sibling that isn't on the
	// lightbox's ancestor path — that covers the header, footer, and the
	// skywatching sections, without inerting the lightbox's own ancestors.
	// `inertedEls` records exactly what we set so close() can undo precisely
	// what open() did (never touch elements that were already inert). `inert`
	// is a no-op assignment on the handful of pre-2023 browsers that lack it;
	// the Tab focus trap below is the belt to this suspenders.
	var inertedEls = [];
	function setBackgroundInert(on) {
		if (on) {
			inertedEls = [];
			var node = lightbox;
			// Bounded: DOM depth from lightbox to <body> is a handful of levels.
			while (node && node !== document.body && node.parentNode) {
				var parent = node.parentNode;
				Array.prototype.forEach.call(parent.children, function (sib) {
					if (sib !== node && sib.tagName !== 'SCRIPT' && !sib.inert) {
						sib.inert = true;
						inertedEls.push(sib);
					}
				});
				node = parent;
			}
		} else {
			inertedEls.forEach(function (el) { el.inert = false; });
			inertedEls = [];
		}
	}

	// open(card, moveFocus) — populate and show the lightbox for `card`.
	// moveFocus (default true) controls whether focus jumps to the Close
	// button. Prev/next navigation passes false so it can keep focus on the
	// button the user is pressing (see navigate()); a fresh open from a card
	// click passes nothing and gets the default focus-to-Close behavior.
	function open(card, moveFocus) {
		// Snapshot whether this is a fresh open vs. a re-populate during
		// navigation — we only toggle background inert on the FIRST open, so
		// close() has an accurate inertedEls list to restore.
		var wasHidden = lightbox.hidden;
		lastFocused = card;

		// Snapshot siblings within the SAME category grid. .closest('.sky-grid')
		// finds the nearest enclosing grid; each section has its own, so we
		// naturally scope to the current category.
		var grid = card.closest('.sky-grid');
		currentSiblings = grid
			? Array.prototype.slice.call(grid.querySelectorAll('.sky-card'))
			: [card];
		currentIndex = currentSiblings.indexOf(card);

		img.src           = card.dataset.preview;
		img.alt           = card.dataset.title;
		titleEl.textContent = card.dataset.title;
		descEl.textContent  = card.dataset.description;
		locEl.textContent   = card.dataset.location;
		dateEl.textContent  = card.dataset.date;

		// Enable/disable nav buttons at boundaries. We use `disabled`
		// (not hiding) so the user gets a visible "end of category" cue
		// and the layout doesn't shift on first/last image.
		prevBtn.disabled = currentIndex <= 0;
		nextBtn.disabled = currentIndex >= currentSiblings.length - 1;

		lightbox.hidden = false;
		// Lock the page scroll so the page underneath doesn't move
		// while the lightbox is open.
		document.body.style.overflow = 'hidden';
		// Inert the background only on the first open — re-running it while
		// already open would rebuild inertedEls from elements that are already
		// inert (the `!sib.inert` guard would skip them), leaving close() with
		// an empty list and the page stuck inert.
		if (wasHidden) setBackgroundInert(true);
		if (moveFocus !== false) closeBtn.focus();
	}

	function close() {
		lightbox.hidden = true;
		// Clear the src so the browser can free the decoded image memory
		// when many lightbox openings have happened in a single session.
		img.src = '';
		document.body.style.overflow = '';
		// Restore the background before returning focus, so the element we
		// hand focus back to is no longer inert (focusing an inert element
		// silently does nothing).
		setBackgroundInert(false);
		if (lastFocused) lastFocused.focus();
	}

	// Move within the current category by `delta` (-1 prev, +1 next).
	// Boundary-safe — bails if at the start/end of the set.
	function navigate(delta) {
		var newIndex = currentIndex + delta;
		if (newIndex < 0 || newIndex >= currentSiblings.length) return;
		// Re-open the new card without changing `lastFocused` — that
		// should remain the card the user originally clicked, so
		// Escape returns focus to where they started. moveFocus=false stops
		// open() from yanking focus to the Close button on every step, which
		// made keyboard/repeat navigation impossible (each arrow press pulled
		// focus off the prev/next control).
		var prevLast = lastFocused;
		open(currentSiblings[newIndex], false);
		lastFocused = prevLast;

		// Keep focus on the control the user pressed so repeated prev/next
		// (arrow keys or clicks) stays put. If that control just became
		// disabled at a boundary — a disabled element can't hold focus — hand
		// focus to the opposite still-enabled control, or Close as a last
		// resort, instead of letting it fall back to <body>.
		var pressed  = delta < 0 ? prevBtn : nextBtn;
		var opposite = delta < 0 ? nextBtn : prevBtn;
		if (pressed.disabled) {
			(opposite.disabled ? closeBtn : opposite).focus();
		} else {
			pressed.focus();
		}
	}

	document.querySelectorAll('.sky-card').forEach(function (card) {
		card.addEventListener('click', function () { open(card); });
	});

	closeBtn.addEventListener('click', close);
	prevBtn.addEventListener('click', function () { navigate(-1); });
	nextBtn.addEventListener('click', function () { navigate(1); });

	// Click outside the image frame (on the dark backdrop) also closes.
	// Only fires when the click target is the lightbox itself — clicks on
	// the image, buttons, or caption bubble up to here but with different
	// targets, so they don't trigger close.
	lightbox.addEventListener('click', function (e) {
		if (e.target === lightbox) close();
	});

	// Keyboard: Tab traps focus within the lightbox, Escape closes, arrow keys
	// navigate within category. Only intercept when the lightbox is open.
	document.addEventListener('keydown', function (e) {
		if (lightbox.hidden) return;

		// ── Focus trap ──────────────────────────────────────────────────────
		// The inert background already keeps focus out of the page, but Tab off
		// the last control would still escape to the browser chrome and back.
		// Cycle focus within the lightbox's own enabled controls so it stays a
		// true modal. Mirrors the detail.js OSD-lightbox trap. `:not([disabled])`
		// skips the prev/next buttons when they're disabled at a boundary.
		if (e.key === 'Tab') {
			var focusable = Array.prototype.slice.call(
				lightbox.querySelectorAll('button:not([disabled])')
			);
			if (focusable.length === 0) { e.preventDefault(); return; }
			var first = focusable[0];
			var last  = focusable[focusable.length - 1];
			if (e.shiftKey) {
				if (document.activeElement === first) { e.preventDefault(); last.focus(); }
			} else {
				if (document.activeElement === last) { e.preventDefault(); first.focus(); }
			}
			return;
		}

		if (e.key === 'Escape')     { close(); }
		else if (e.key === 'ArrowLeft')  { navigate(-1); }
		else if (e.key === 'ArrowRight') { navigate(1);  }
	});
}());
</script>
